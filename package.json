{
  "name": "sakupos-coffee",
  "version": "1.0.0",
  "description": "SakuPOS - Coffee — Counter POS & Barista KDS System",
  "main": "dist-electron/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"cyan,green\" \"bun run server:dev\" \"bun run client:dev\"",
    "dev:staging": "cross-env APP_ENV=staging concurrently -k -n \"SERVER,CLIENT\" -c \"cyan,green\" \"bun run server:staging\" \"bun run client:staging\"",
    "dev:production": "cross-env APP_ENV=production concurrently -k -n \"SERVER,CLIENT\" -c \"cyan,green\" \"bun run server:prod\" \"bun run client:prod\"",
    "server:dev": "cross-env APP_ENV=development tsx watch server/index.ts",
    "server:staging": "cross-env APP_ENV=staging tsx watch server/index.ts",
    "server:prod": "cross-env APP_ENV=production tsx watch server/index.ts",
    "client:dev": "vite --port=5174 --host=0.0.0.0 --mode development",
    "client:staging": "vite --port=5174 --host=0.0.0.0 --mode staging",
    "client:prod": "vite --port=5174 --host=0.0.0.0 --mode production",
    "build": "tsc --noEmit && vite build",
    "build:electron": "tsx electron/build-electron.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset": "tsx scripts/db-seed.ts --reset",
    "test": "tsx --test tests/**/*.test.ts",
    "test:p0": "tsx --test tests/p0-core.test.ts",
    "test:p1": "tsx --test tests/p1-lan-sqlite.test.ts",
    "electron:dev": "cross-env APP_ENV=development concurrently -k -n \"SERVER,CLIENT,ELECTRON\" -c \"cyan,green,magenta\" \"bun run server:dev\" \"bun run client:dev\" \"tsx electron/run-electron.ts\"",
    "electron:prod": "cross-env APP_ENV=production concurrently -k -n \"SERVER,CLIENT,ELECTRON\" -c \"cyan,green,magenta\" \"bun run server:prod\" \"bun run client:prod\" \"tsx electron/run-electron.ts\"",
    "build:win": "bun run build && bun run build:electron && tsx scripts/build-win-electron.ts"
  },
  "keywords": [
    "sakupos",
    "coffee",
    "pos",
    "grab-and-go",
    "kds",
    "cup-label-printer"
  ],
  "author": "SakuPOS",
  "license": "ISC",
  "build": {
    "appId": "com.sakupos.coffee",
    "productName": "SakuPOS - Coffee",
    "directories": {
      "output": "release/artifacts"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/edc/**/*.cjs",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/sakupos-logo.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SakuPOS - Coffee",
      "uninstallDisplayName": "SakuPOS - Coffee",
      "artifactName": "SakuPOS-Coffee-Setup-${version}.${ext}",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "serialport": "^13.0.0",
    "uuid": "^14.0.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
